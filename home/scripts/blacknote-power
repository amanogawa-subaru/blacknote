#!/usr/bin/env bash

lock="󰌾  Lock"
suspend="󰤄  Suspend"
logout="󰍃  Logout"
reboot="󰜉  Reboot"
poweroff="󰐥  Power off"

choice="$(
    printf '%s\n' \
        "$lock" \
        "$suspend" \
        "$logout" \
        "$reboot" \
        "$poweroff" |
        "$HOME/nixos-profiles/blacknote/home/scripts/blacknote-wofi" power --dmenu --prompt "Power"
)" || exit 0

case "$choice" in
    "$lock")
        swaylock -f
        ;;
    "$suspend")
        systemctl suspend
        ;;
    "$logout")
        loginctl terminate-session "$XDG_SESSION_ID"
        ;;
    "$reboot")
        systemctl reboot
        ;;
    "$poweroff")
        systemctl poweroff
        ;;
esac
