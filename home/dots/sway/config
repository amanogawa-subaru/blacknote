# Blacknote — Sway configuration

# NixOS-provided Sway integration
include /etc/sway/config.d/*

# --- UWSM session initialization ---
exec uwsm finalize SWAYSOCK

# --- Set variables ---
set $mod Mod4
set $term foot
set $menu wofi --show drun
set $sway_dir $HOME/nixos-profiles/blacknote/home/dots/sway
set $scripts $HOME/nixos-profiles/blacknote/home/scripts

# --- Appearance ---

# Gruvbox colors
set $base00 #282828
set $base01 #3c3836
set $base02 #504945
set $base03 #665c54
set $base04 #bdae93
set $base05 #d5c4a1
set $base06 #ebdbb2
set $base07 #fbf1c7

set $base08 #fb4934
set $base09 #fe8019
set $base0A #fabd2f
set $base0B #b8bb26
set $base0C #8ec07c
set $base0D #83a598
set $base0E #d3869b
set $base0F #d65d0e

# Sway colors
# Window state            border     bg         text       indicator  child_border
client.focused            $base09    $base00    $base06    $base09    $base09
client.focused_inactive   $base02    $base00    $base04    $base02    $base02
client.unfocused          $base01    $base00    $base03    $base01    $base01
client.urgent             $base08    $base00    $base07    $base08    $base08

# Gaps
gaps inner 10
gaps outer 5

# Set wallpaper
output * bg $sway_dir/wallpapers/gruvbox_grid.png fill

# --- Launchers ---
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec librewolf

# --- Window manipulation ---
bindsym $mod+q kill

bindsym $mod+v splith
bindsym $mod+g splitv

bindsym $mod+f floating toggle
bindsym $mod+Shift+f fullscreen

# Control windows with mod+mouse
floating_modifier $mod normal

# Toggle split orientation
bindsym $mod+o layout toggle split

# Floating apps
for_window [app_id="imv"] floating enable, move position center

# Resize mode
set $resize_mode "resize"
bindsym $mod+r mode $resize_mode
mode $resize_mode {
    bindsym h resize shrink width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize grow width 10 px

    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# Directional focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Directional swapping
bindsym $mod+Shift+h mark --add "_swap", focus left, swap container with mark "_swap", focus left, unmark "_swap"
bindsym $mod+Shift+j mark --add "_swap", focus down, swap container with mark "_swap", focus down, unmark "_swap"
bindsym $mod+Shift+k mark --add "_swap", focus up, swap container with mark "_swap", focus up, unmark "_swap"
bindsym $mod+Shift+l mark --add "_swap", focus right, swap container with mark "_swap", focus right, unmark "_swap"

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Touchpad gestures
input type:touchpad {
    natural_scroll enabled
    tap enabled
    tap_button_map lrm
}

bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev

# Session controls
bindsym $mod+Shift+p exec $scripts/blacknote-power
bindsym $mod+Shift+r reload
bindsym $mod+Shift+q exec uwsm stop
